# Add these values only when the corresponding backend integration is enabled.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key


# Mapbox public runtime token. This value is bundled into the client.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Mapbox secret token with DOWNLOADS:READ. Keep this in local/EAS secret storage.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=